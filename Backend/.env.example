# Server Port
PORT=5000

# Environment Mode
NODE_ENV=production

# MongoDB Connection String (e.g. MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/blogapp?retryWrites=true&w=majority)
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/blogapp

# Security Secrets
JWT_SECRET=your_super_secret_jwt_key_here
SESSION_SECRET=your_super_secret_session_key_here

# Frontend Production URL (e.g. https://your-app.vercel.app)
FRONTEND_URL=https://your-frontend-domain.vercel.app
